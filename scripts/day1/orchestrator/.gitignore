# editable-install and tool artefacts (phase2/02-orchestrator.sh excludes the same set from its rsync)
*.egg-info/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.venv/
build/
dist/
# a ledger or local secrets made inside the package tree hold Principal data (rule §7.2: never in git). Every *.env is
# ignored (a copy of /etc/atlas/orchestrator.env, redis.env, engines/<key>.env taken while debugging on the node would
# otherwise ride in on `git add -A`); the fixture env files are the one tracked exception (invented placeholder names).
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.db
*.env
.env
!tests/fixtures/config/atlas.env
!tests/fixtures/config/**/*.env
secrets/

# /etc/squid/squid.conf — A.T.L.A.S. outbound allowlist proxy (Section 12.5; CONVENTIONS.md §7.1).
# Rendered by phase1/04-system.sh (_squid_render) from config/squid.conf.tmpl; Ubuntu's original is kept as
# squid.conf.dist. Ubuntu's stock file has "http_access allow localhost" BEFORE its conf.d include, which would let
# every local client through unfiltered (platform research item 6), so the whole file is replaced rather than extended.
#
# No SSL bump: the allow/deny decision is made on the CONNECT host:443 line, which carries the hostname in clear.
#
# Binding (CONVENTIONS §8 "squid 3128 (loopback only)"): 127.0.0.1 always. Containers must also use this proxy
# (rule §7.1) and reach the host only at a bridge gateway address, so step 6 re-renders this file once dockerd has
# created docker0 and adds exactly one more listener, ${SQUID_EXTRA_PORTS} = "http_port <docker0 gateway>:3128"
# (172.17.0.1 unless Docker had to pick another range; read back from /etc/atlas/docker.env DOCKER_GW on every later
# render). Containers on compose bridges reach that address too: it is a local address of the host, whatever
# interface the packet arrives on. net.ipv4.ip_nonlocal_bind=1 (sysctl.d/90-atlas-squid.conf, step 6) lets squid bind
# it at boot before docker0 exists. The LAN address and the WireGuard bridge gateway are never bound: VPN clients
# must never use the node as an outbound proxy. Second fence: ufw admits 3128 only on docker0 and from
# 172.16.0.0/12 (never on the LAN interface) and the "clients" acl below admits loopback and ${SQUID_CLIENT_NETS}.
#
# IP-literal destinations are refused outright and dstdomain runs with -n (fix round, blocker): without -n, squid
# resolves the PTR of an IP-literal destination (CONNECT 203.0.113.5:443) and matches the returned NAME against the
# list, so anyone owning an address whose PTR says "github.com" would walk through the allowlist. With -n there is
# no reverse lookup at all, and the ip_literal acl denies every dotted-quad or IPv6 destination before the allow
# line. Behaviour VERIFIED against a live squid during the fix round: CONNECT 1.1.1.1:443, GET http://1.1.1.1/ and
# CONNECT [2606:4700:4700::1111]:443 are TCP_DENIED/403; an allowlisted name tunnels; `squid -k parse` is clean.
# phase1/04-system.sh (_proxy_selftest) proves the same on the node at every step-4 run.

http_port 127.0.0.1:3128
${SQUID_EXTRA_PORTS}

acl SSL_ports port 443
acl Safe_ports port 80
acl Safe_ports port 443
acl allowed dstdomain -n "${SQUID_ALLOWLIST}"
acl ip_literal dstdom_regex -n ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ^\[ ^[0-9a-fA-F]*:[0-9a-fA-F:]*$
acl clients src 127.0.0.1/32 ::1/128 ${SQUID_CLIENT_NETS}

http_access deny !Safe_ports
http_access deny CONNECT !SSL_ports
http_access deny manager
http_access deny ip_literal
http_access allow clients allowed
http_access deny all

# No disk or memory cache: apt, pip and model pulls verify their own checksums and a cache would only hold stale blobs.
cache deny all
cache_mem 8 MB

# Per-request log with the hostname of every denied CONNECT (Section 12.5 "everything else denied and logged").
access_log daemon:/var/log/squid/access.log squid
cache_log /var/log/squid/cache.log
logfile_rotate 7
coredump_dir /var/spool/squid

# Do not leak the node to the sites it talks to.
forwarded_for delete
via off
httpd_suppress_version_string on

# Fast restarts during Phase 1 (default 30 s).
shutdown_lifetime 3 seconds

# /etc/atlas/atlas.env — A.T.L.A.S. Day 1 non-secret settings (CONVENTIONS.md §3).
# Installed from scripts/day1/config/atlas.env.example by load_env on the first run, mode 640 root:atlas.
# Sourced by every phase script. Secrets NEVER go here: they live one per file under /etc/atlas/secrets/ (§2).
# Blank values marked "auto" are detected by load_env on first use and written back into this file so they stay
# stable across reboots. Values marked "CONFIRM" must be set by the Principal before Phase 1 runs; load_env dies
# naming any that are blank.

# The Principal's own login user, created by the Ubuntu installer. auto: the first non-system user (uid >= 1000)
# whose home directory exists under /home.
PRINCIPAL_USER=

# Time zone for timers and logs. auto: /etc/timezone, then `timedatectl show -p Timezone`, default Australia/Sydney.
TZ=

# The Wi-Fi/LAN interface the node uses. auto: the interface of the default route (`ip route show default`).
LAN_IFACE=

# The LAN network in CIDR form (ufw rules, xrdp/Cockpit bindings). auto: the IPv4 address on LAN_IFACE reduced to its
# network, e.g. 192.168.1.0/24. load_env also derives LAN_IP (the node's own address) at run time; it is not stored.
LAN_CIDR=

# WireGuard settings (WG-Easy runs in Docker, so wg0 lives inside the container; WG_IFACE names it for compose and ufw).
WG_IFACE=wg0
WG_CIDR=10.8.0.0/24
WG_PORT=51820

# Public DNS names (Section 12.3, 12.5). VPN_HOST is the DNS-only record the ddns updater keeps current.
DOMAIN=sovereign-node.link
VPN_HOST=vpn.sovereign-node.link

# The 8 TB data drive as a stable /dev/disk/by-id path (never /dev/nvmeXn1, which can swap between boots).
# auto: the largest NVMe disk that holds no mounted filesystem (itself or any partition/LUKS child), resolved to its
# /dev/disk/by-id/nvme-<model>_<serial> link. Detected once and persisted here BEFORE Phase 1 step 2 formats it.
DATA_DISK=

# Where the installer left the Cloudflare token file that Phase 2 step 6b relocates and shreds (R7, V23).
# auto: /home/$PRINCIPAL_USER/CLOUDFLARE.txt
CLOUDFLARE_TXT=

# CONFIRM. The two Google accounts for the OAuth pause (Phase 2 step 6c, V20), space-separated, each tagged with its
# hemisphere as email:corporate or email:estate. Example: GOOGLE_ACCOUNTS="you@company.com:corporate you@gmail.com:estate"
GOOGLE_ACCOUNTS=

# CONFIRM. The Windows PC share mounted on demand (Phase 2 step 9), as //host/share. Credentials go in
# /etc/atlas/secrets/smb.cred, never here. Example: WINDOWS_SHARE="//192.168.1.50/atlas"
WINDOWS_SHARE=

# CONFIRM. Family names for the router hard rules (Section 7.2 rule 1): the orchestrator replaces
# FAMILY_NAMES_PLACEHOLDER in config/router-rules.json with these, space-separated, lowercase not required.
# Example: FAMILY_NAMES="Rida Moussa"
FAMILY_NAMES=

# ntfy topic the node pushes to (http://127.0.0.1:8090/$NTFY_TOPIC, token in /etc/atlas/secrets/ntfy.env).
NTFY_TOPIC=atlas

# Host ports (CONVENTIONS.md §8). Engines listen on LLAMA_PORT_BASE + index in config/engines.json order (8101..8110).
OPENWEBUI_PORT=3000
ORCH_PORT=8800
LLAMA_PORT_BASE=8100

# Hugging Face endpoint override for hf_download; leave unset to use https://huggingface.co through the allowlist proxy.
HF_ENDPOINT=

# Planning figure for the Phase 3 duration estimate (~690 GB at 100 Mbps ≈ 15 h). Not a rate limit.
DOWNLOAD_MBPS=100

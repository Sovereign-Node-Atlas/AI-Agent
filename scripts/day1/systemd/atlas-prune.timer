# /etc/systemd/system/atlas-prune.timer — every 72 hours (Section 9.6 "A Celery beat job every 72 hours"; the
# timer enqueues, Celery executes: CONVENTIONS.md §8). Daily calendar at 03:10 local (after the 02:30 AEGIS window; the
# sweep waits in the cpu queue while a freeze is on) PLUS the >= 71 h stamp condition in atlas-prune.service (fix round
# 2): a day-of-month list gave 1-day and 4-day gaps at month ends, a monotonic OnBootSec/OnUnitActiveSec pair fired
# after EVERY boot and ignored Persistent=. Persistent=true runs a sweep missed while the node was off; the stamp
# decides whether 71 h have really passed. Installed verbatim by phase2/08-sentinel.sh.
[Unit]
Description=Run the A.T.L.A.S. semantic pruning sweep every 72 hours (daily check, >=71 h stamp)

[Timer]
OnCalendar=*-*-* 03:10:00
RandomizedDelaySec=30min
AccuracySec=1min
Persistent=true
Unit=atlas-prune.service

[Install]
WantedBy=timers.target

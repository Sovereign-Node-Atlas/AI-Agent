# /etc/systemd/system/atlas-restic-check.service — the quarterly restore test (Section 9.5 "Restore test: quarterly
# restore to a scratch directory, verified by checksum, logged"; V13). Installed by phase2/07-restic.sh through
# render_template (ATLAS_ETC, ATLAS_OPT substituted).
# Step 1 runs verify/v13-restic.sh through lib/common.sh's run_verify so the result lands in verify.jsonl (phase
# "quarterly") as well as in the journal; step 2 reads back a tenth of the repository data (restic check
# --read-data-subset, VERIFIED flag). A failure of either fails the unit, which the journal and ntfy (the verify
# script calls notify) make visible.

[Unit]
Description=AEGIS quarterly restore test and repository check (Section 9.5, V13)
RequiresMountsFor=/srv/backups
ConditionPathExists=${ATLAS_ETC}/restic.env

[Service]
Type=oneshot
EnvironmentFile=${ATLAS_ETC}/restic.env
Environment=ATLAS_PHASE=quarterly
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
ExecStart=/bin/bash -c 'source ${ATLAS_OPT}/day1/lib/common.sh && run_verify V13 v13-restic.sh'
ExecStart=/usr/bin/restic check --read-data-subset=1/10
TimeoutStartSec=4h

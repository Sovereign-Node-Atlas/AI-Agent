# /etc/systemd/system/atlas-docker-egress.service — container egress rules in the DOCKER-USER chain.
# Docker publishes ports and forwards container traffic before ufw sees it (adjudicated conflict 4), so the
# "default deny outbound except the allowlist" rule of Section 3.6/12.5 is enforced for containers here.
#
# No window without rules: (1) ufw's after.rules (phase1/04-system.sh) pre-creates DOCKER-USER with its terminal
# DROPs at `ufw enable`, before dockerd exists; (2) a docker.service drop-in (phase1/06-docker.sh) runs the same
# script as ExecStartPre, so the full set is in place before any restart:unless-stopped container starts; (3) this
# unit re-applies it after dockerd is up and whenever docker restarts (PartOf=). If it ever fails, the after.rules
# baseline still drops everything leaving a bridge for the LAN interface.
#
# REVERSE INTERACTION (contract for Phases 2-4): `ufw reload`, `ufw enable` and `ufw --force reset` run
# iptables-restore over after.rules, which flushes the live DOCKER-USER chain back to that baseline: the
# `--ctstate DNAT -j ACCEPT` rules and the logging are gone until this script runs again, so VPN clients lose ntfy and
# Open WebUI with no log line pointing at the cause (availability only; the fallback is stricter). Therefore every
# `ufw reload|enable|reset` MUST be followed by `systemctl restart atlas-docker-egress.service`. Made automatic where
# a unit is involved: /etc/systemd/system/ufw.service.d/atlas.conf (phase1/04-system.sh) runs the script as
# ExecStartPost of ufw.service (boot, `systemctl restart ufw`), and step 4's _ufw_rules calls it after `ufw enable`.
# A bare `ufw reload` from a shell is not covered by any unit: restart this service by hand afterwards.
# Installed by phase1/06-docker.sh; the rules script is phase1/docker-egress-rules.sh -> /usr/local/sbin/atlas-docker-egress.
[Unit]
Description=ATLAS container egress rules (DOCKER-USER chain)
After=docker.service
Requires=docker.service
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/atlas-docker-egress

[Install]
WantedBy=docker.service

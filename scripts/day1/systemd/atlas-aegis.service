# /etc/systemd/system/atlas-aegis.service — the AEGIS restic backup with orchestrator freeze/thaw (Section 9.5; V13).
# Installed by phase2/07-restic.sh through render_template (ATLAS_ETC, ATLAS_OPT, ATLAS_SRV substituted). The helper
# /usr/local/sbin/atlas-aegis (repository file phase2/atlas-aegis.sh, installed by the same step) carries the
# freeze/thaw logic; restic itself is typed here. This unit takes the SNAPSHOT only; the D9 retention
# (`restic forget ... --prune`) is atlas-aegis-forget.service, which Requires= this one and runs after it, and ONLY the
# nightly timer starts that (fix round 2: Section 16.3 item 5 reserves deleting backups for the Principal, so the manual
# trigger can add snapshots but never prune them).
#
# Who starts it:
#   * atlas-aegis.timer -> atlas-aegis-forget.service -> (Requires/After) this unit, nightly 02:30.
#   * atlas-aegis-trigger.path: the orchestrator's manual `[EXECUTE AEGIS BACKUP]` task (9.5) creates the empty file
#     /run/atlas/aegis-request as atlas; PID 1 starts this unit, whose first ExecStartPre removes the request (rm -f
#     unlinks, it never follows a symlink, so a planted link in the atlas-owned /run/atlas is harmless). NO sudo, NO
#     second sudoers fragment: /etc/sudoers.d/atlas-engines stays the only NOPASSWD grant (CONVENTIONS.md §8).
#   StartLimit: two starts per 6 h (the nightly plus one manual), so repeated requests cannot keep the queues frozen
#   and the disk busy; after a third request the path unit fails with unit-start-limit-hit and is re-armed with
#   `systemctl reset-failed atlas-aegis.service atlas-aegis-trigger.path && systemctl start atlas-aegis-trigger.path`.
#
# Sequence (Section 9.5 "Freeze" row; CONVENTIONS.md §8 / S23 say "the same pattern" as Sentinel, i.e. a timer that
# only enqueues — this unit DEVIATES, deliberately and recorded for the baseline: restic.pass and /srv/backups are
# root-only (CONVENTIONS.md §2), so a Celery-executed restic cannot exist without a root helper; the unit enqueues the
# freeze and thaw tasks and runs restic as root between them, and it is also the fallback when the orchestrator is
# down. §8's last paragraph and S23 should be amended to that wording):
#   ExecStartPre  `atlas-aegis freeze` — when atlas-orchestrator AND atlas-celery-cpu are active it enqueues the
#                 package's `aegis-freeze` task and waits (900 s): the gpu consumer pauses and the freeze flag goes up so
#                 every memory writer waits (a consistent set for ChromaDB's persist dir and the LightRAG files). A
#                 failure with the orchestrator UP FAILS THE UNIT (an unfrozen backup is never reported as success).
#                 Only when the orchestrator is inactive is the freeze skipped, explicitly, for a crash-consistent
#                 backup ("a backup beats no backup"; the journal names the skip). The helper's own intent marker lives
#                 in THIS unit's RuntimeDirectory /run/atlas-aegis (root:root 755): root never writes by name into the
#                 atlas-owned /run/atlas (symlink planting), it only reads the freeze flag there (fix round 2).
#   ExecStartPre  `atlas-aegis manifests` — AS ATLAS (runuser): a copy of every regular <models|engines>/<key>/
#                 MANIFEST.json into ${ATLAS_SRV}/data/manifests, so "a manifest of exact model versions and checksums
#                 is backed up instead" of the excluded weights (Appendix C). The data tree is atlas-owned, so the copy
#                 runs as its owner and a planted symlink gains nothing.
#   ExecStart     restic backup of the Appendix C include set (root: the passphrase and /srv/backups are root-only).
#   ExecStopPost  `atlas-aegis finish` — runs whether the backup succeeded or failed. Thaw is delivered through
#                 celery's broadcast channel (`celery control add_consumer cpu|gpu`), which the workers still read while
#                 a task queue is cancelled; the flag comes down, then the package's `aegis-thaw` task is enqueued for
#                 its ledger row and spool replay. If a worker does not answer, both workers are restarted and the unit
#                 is reported FAILED (loud, never silent). `finish` pushes a ntfy alert whenever $SERVICE_RESULT is not
#                 success or the thaw needed the fallback (token read by root from secrets/ntfy.env, never on argv).
# Contract with the `atlas` package: `atlas-admin enqueue aegis-freeze --wait N` / `enqueue aegis-thaw --wait N`
# (exit 0 when the task completed within N seconds), the freeze flag at /run/atlas/aegis-freeze (AEGIS_FREEZE_FLAG),
# `atlas.celery_app` answering `celery control add_consumer`, and the manual trigger = create /run/atlas/aegis-request
# then confirm with `systemctl is-active atlas-aegis.service` (activating|active within ~30 s). The unit loads
# orchestrator.env, memory.env and secrets/redis.env so runuser inherits the settings and the broker URL.

[Unit]
Description=AEGIS restic backup with orchestrator freeze/thaw (Section 9.5)
After=atlas-orchestrator.service atlas-celery-cpu.service
RequiresMountsFor=${ATLAS_SRV} /srv/backups /srv/cold
Documentation=file:${ATLAS_ETC}/restic.env
StartLimitIntervalSec=6h
StartLimitBurst=2

[Service]
Type=oneshot
EnvironmentFile=${ATLAS_ETC}/restic.env
EnvironmentFile=${ATLAS_ETC}/orchestrator.env
EnvironmentFile=${ATLAS_ETC}/secrets/redis.env
EnvironmentFile=-${ATLAS_ETC}/memory.env
Environment=ATLAS_ETC=${ATLAS_ETC} ATLAS_OPT=${ATLAS_OPT} ATLAS_SRV=${ATLAS_SRV}
# root:root 755 on tmpfs; the helper's intent marker lives here (never in the atlas-owned /run/atlas).
RuntimeDirectory=atlas-aegis
RuntimeDirectoryMode=0755
# restic exit 3 = "some source files could not be read" (a path in the include set missing until a later step, or a
# file changed mid-read): the snapshot exists, restic printed the names; a warning, not a failed backup. The helper
# never exits 3.
SuccessExitStatus=3
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
ExecStartPre=/bin/rm -f /run/atlas/aegis-request
ExecStartPre=/usr/local/sbin/atlas-aegis freeze
ExecStartPre=/usr/local/sbin/atlas-aegis manifests
ExecStart=/usr/bin/restic backup --files-from ${ATLAS_ETC}/restic-include.txt --exclude-file ${ATLAS_ETC}/restic-exclude.txt --exclude-caches --one-file-system --tag aegis
ExecStopPost=/usr/local/sbin/atlas-aegis finish
TimeoutStartSec=6h

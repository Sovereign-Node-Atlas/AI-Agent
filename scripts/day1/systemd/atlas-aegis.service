# /etc/systemd/system/atlas-aegis.service — AEGIS nightly backup (Section 9.5; V13; D9 retention 30 nightly, 12 monthly).
# Installed by phase2/07-restic.sh through render_template (ATLAS_ETC, ATLAS_OPT, ATLAS_SRV substituted). The helper
# /usr/local/sbin/atlas-aegis (written by the same step) carries the freeze/thaw logic; restic itself is typed here.
#
# How freeze/thaw and the backup fit together (Section 9.5 "Freeze" row; CONVENTIONS.md §8 "AEGIS nightly is the same
# pattern" as the Sentinel timer: the timer's unit asks the orchestrator's Celery task to do the freezing):
#   ExecStartPre  `atlas-aegis freeze` — when atlas-orchestrator AND atlas-celery-cpu are active it enqueues the
#                 package's `aegis-freeze` task and waits (900 s): the queues pause and the freeze flag goes up so every
#                 memory writer waits (a consistent set for ChromaDB's persist dir and the LightRAG files). A failure
#                 with the orchestrator UP FAILS THE UNIT (fix round: an unfrozen backup is never reported as success).
#                 Only when the orchestrator is inactive is the freeze skipped, explicitly, for a crash-consistent
#                 backup ("a backup beats no backup"; the journal names the skip).
#   ExecStartPre  `atlas-aegis manifests` — a copy of every <models|engines>/<key>/MANIFEST.json into
#                 ${ATLAS_SRV}/data/manifests, so "a manifest of exact model versions and checksums is backed up instead"
#                 of the excluded weights (Appendix C).
#   ExecStart     restic backup of the Appendix C include set (root: the passphrase and /srv/backups are root-only,
#                 CONVENTIONS.md §2), then `restic forget --keep-within 1d --keep-daily 30 --keep-monthly 12 --prune`
#                 (--keep-within 1d is the floor: a second run on the same day never deletes that day's earlier
#                 snapshot; Section 16.3 item 5).
#   ExecStopPost  `atlas-aegis finish` — runs whether the backup succeeded or failed. Thaw is delivered through
#                 celery's broadcast channel (`celery control add_consumer cpu|gpu`), which the workers still read while
#                 their task queues are cancelled; an `enqueue aegis-thaw` alone would sit for ever in the paused cpu
#                 queue (fix round: deadlock). The flag comes down, then the package's `aegis-thaw` task is enqueued
#                 (now deliverable) for its ledger row. If a worker does not answer, both workers are restarted and the
#                 unit is reported FAILED (loud, never silent). `finish` pushes a ntfy alert whenever $SERVICE_RESULT is
#                 not success or the thaw needed the fallback.
# The manual `[EXECUTE AEGIS BACKUP]` trigger (9.5) is the same code path: the orchestrator's `aegis_manual_backup`
# task runs `sudo systemctl start atlas-aegis.service` (or `start --no-block`, both permitted) under
# /etc/sudoers.d/atlas-aegis (written by phase2/07-restic.sh). StartLimit: two starts per 6 h (the nightly plus one
# manual), so repeated triggers cannot keep the queues frozen and the disk busy.
# Contract with the `atlas` package: `atlas-admin enqueue aegis-freeze --wait N` / `enqueue aegis-thaw --wait N`
# (exit 0 when the task completed within N seconds), the freeze flag at /run/atlas/aegis-freeze (AEGIS_FREEZE_FLAG),
# and `atlas.celery_app` answering `celery control add_consumer`. The unit loads orchestrator.env, memory.env and
# secrets/redis.env so runuser inherits the settings and the broker URL.

[Unit]
Description=AEGIS nightly restic backup with orchestrator freeze/thaw (Section 9.5)
After=atlas-orchestrator.service atlas-celery-cpu.service
RequiresMountsFor=${ATLAS_SRV} /srv/backups /srv/cold
Documentation=file:${ATLAS_ETC}/restic.env
StartLimitIntervalSec=6h
StartLimitBurst=2

[Service]
Type=oneshot
EnvironmentFile=${ATLAS_ETC}/restic.env
EnvironmentFile=${ATLAS_ETC}/orchestrator.env
EnvironmentFile=${ATLAS_ETC}/secrets/redis.env
EnvironmentFile=-${ATLAS_ETC}/memory.env
Environment=ATLAS_ETC=${ATLAS_ETC} ATLAS_OPT=${ATLAS_OPT} ATLAS_SRV=${ATLAS_SRV}
# restic exit 3 = "some source files could not be read" (a path in the include set missing until a later step, or a
# file changed mid-read): the snapshot exists, restic printed the names; a warning, not a failed backup. The helper
# never exits 3.
SuccessExitStatus=3
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
ExecStartPre=/usr/local/sbin/atlas-aegis freeze
ExecStartPre=/usr/local/sbin/atlas-aegis manifests
ExecStart=/usr/bin/restic backup --files-from ${ATLAS_ETC}/restic-include.txt --exclude-file ${ATLAS_ETC}/restic-exclude.txt --exclude-caches --one-file-system --tag aegis --tag nightly
ExecStart=/usr/bin/restic forget --keep-within 1d --keep-daily 30 --keep-monthly 12 --prune
ExecStopPost=/usr/local/sbin/atlas-aegis finish
TimeoutStartSec=6h

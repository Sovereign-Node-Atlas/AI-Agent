# llama-server@.service — one llama.cpp engine per instance, %i = engine key from config/engines.json
# (CONVENTIONS.md §8: llama-server@gpt-oss-120b ... llama-server@rerank-bge-v2-m3).
# Installed by phase2/01-llama.sh through render_template with ATLAS_ETC and ATLAS_SRV substituted; %i and $ARGS are
# systemd syntax and are left untouched. The env file is rendered by phase2/engine-env.py from config/engines.json.
#
# Readiness: the HTTP listener starts before the model loads and /health answers 503 until "model loaded", then 200
# (llama-cpp-vulkan research §7). ExecStartPost polls /health, so `systemctl start` returns only when the engine can
# serve; TimeoutStartSec bounds a 155 GB load (Section 5.4 says 25-35 s from NVMe, a cold page cache can take minutes).
# Bind: 127.0.0.1 only (CONVENTIONS.md §8), set twice — in $ARGS (--host) and as the LLAMA_ARG_HOST env var.
# Logs: the journal (journalctl -u llama-server@<key>) is where Phase 3 reads the V4 proof line
#       "llama_kv_cache: size = ... K (q8_0): ... V (q8_0): ..." (research conflict h).
# Control path: the orchestrator runs `sudo systemctl start|stop|restart llama-server@<key>` under
#       /etc/sudoers.d/atlas-engines (CONVENTIONS.md §8), written by phase2/01-llama.sh.

[Unit]
Description=A.T.L.A.S. llama-server engine %i
Documentation=file:${ATLAS_ETC}/engines/%i.env
After=local-fs.target
# The model files and the slot directory live on the LUKS data volume (Section 3.5): order after, and require, the mount
# units for those paths, so an enabled resident unit does not burn StartLimitBurst at boot before /srv/atlas is mounted.
RequiresMountsFor=${ATLAS_SRV}/models ${ATLAS_SRV}/data/slots
# A missing model file or a refused KV configuration exits immediately; do not loop on it (rule §7.4 fail loudly).
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=atlas
Group=atlas
SupplementaryGroups=render video
EnvironmentFile=${ATLAS_ETC}/engines/%i.env
Environment=LLAMA_ARG_HOST=127.0.0.1
# No proxy for the engine (fix round 2): phase1/04-system.sh installs HTTP_PROXY/HTTPS_PROXY/NO_PROXY as the manager's
# DefaultEnvironment for every unit, which would hand the engine (built with an HTTPS client, LLAMA_OPENSSL=ON) a working
# route to every allowlisted host through squid on 127.0.0.1:3128, inside IPAddressAllow=localhost. The engine has no
# legitimate outbound need (Section 16.3 item 8); a unit Environment= overrides DefaultEnvironment, so blank them here
# and tell every client library not to look for one (NO_PROXY=*).
Environment=HTTP_PROXY= HTTPS_PROXY= http_proxy= https_proxy= NO_PROXY=* no_proxy=*
# RADV writes its shader cache under $XDG_CACHE_HOME; the atlas system user has no usable HOME.
CacheDirectory=atlas-llama
Environment=XDG_CACHE_HOME=/var/cache/atlas-llama
WorkingDirectory=${ATLAS_SRV}/models
# $ARGS is split at whitespace by systemd with quotes respected and then removed, which is why engine-env.py refuses
# tokens with spaces or quotes; JSON-valued options (chat template kwargs) travel as LLAMA_ARG_* variables in the env file.
ExecStart=/usr/local/bin/llama-server $ARGS
# --noproxy '*': the readiness poll must reach 127.0.0.1 directly whatever the environment says (never via squid).
ExecStartPost=/bin/sh -c 'until curl -sf --noproxy "*" -o /dev/null "http://127.0.0.1:${LLAMA_ARG_PORT}/health"; do sleep 2; done'
Restart=on-failure
RestartSec=5
TimeoutStartSec=900
# SIGTERM is handled by llama-server (server.cpp sigaction); a server stuck in a GPU call may need the SIGKILL.
TimeoutStopSec=120
KillMode=mixed
LimitMEMLOCK=infinity
LimitNOFILE=65536
# Hardening that does not interfere with /dev/dri access or mmap of the model files. NOT added on purpose:
# PrivateDevices/DevicePolicy (the engine needs /dev/dri) and MemoryDenyWriteExecute (Mesa/RADV JIT).
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
# Whole file system read-only for the engine except the slot directory (CacheDirectory stays writable by systemd's own
# rule); the model files are atlas-owned but the running engine must not be able to alter them.
ProtectSystem=strict
ReadWritePaths=${ATLAS_SRV}/data/slots
ReadOnlyPaths=${ATLAS_SRV}/models
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# Fix round 2: the settings that cost nothing for a Vulkan engine and close real escape classes for a process whose uid
# (atlas) is in the docker group, i.e. root-equivalent on this host (phase2/04-memory.sh header). The docker socket is
# reachable by the uid but not by this process: InaccessiblePaths masks it (`-`: no failure when the path is absent;
# both spellings, /run and the /var/run symlink). Slot and shader-cache files are created 0600 (UMask).
CapabilityBoundingSet=
RestrictNamespaces=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
RestrictRealtime=true
SystemCallArchitectures=native
ProtectProc=invisible
UMask=0077
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock
# Network confinement by kernel BPF, independent of ufw and of the proxy variables: the engine (built with an HTTPS
# client, LLAMA_OPENSSL=ON per conflict 10) may only talk on loopback, where the orchestrator and ExecStartPost reach it.
# AF_UNIX stays: UNVERIFIED whether Mesa's device enumeration or the RADV cache needs a local socket, and removing it is
# a change to test on the node (llama-server --list-devices under the unit) before it lands here, not in a template.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=127.0.0.1/32 ::1/128

[Install]
WantedBy=multi-user.target
